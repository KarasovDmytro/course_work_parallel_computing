# Copy this file to .env to change the defaults. The project starts without .env.

# Folder with the dataset on the host (*.txt files, searched recursively).
# It is mounted into the container as /data (read-only).
DATASET_DIR=./data

# Ollama model for query expansion. ollama-init downloads it on start.
OLLAMA_MODEL=qwen2.5:0.5b
